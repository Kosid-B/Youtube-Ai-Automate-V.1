# คัดลอกเป็น .env.local แล้วเติมค่าจริง — ห้าม commit .env.local

# Supabase (ฝั่ง browser ใช้ได้ทั้งคู่ publishable key เป็น public โดยดีไซน์)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ⚠️ ข้าม RLS ทั้งหมด — ใช้ได้เฉพาะ worker/ กับ route handler ฝั่ง server
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (สร้างสคริปต์)
ANTHROPIC_API_KEY=

# สลับไปให้ ChatGPT เขียนสคริปต์แทน — ปล่อยว่าง = ใช้ Anthropic (ค่าเริ่มต้น)
# ต้องตั้ง OPENAI_API_KEY ด้วย · ชื่อรุ่นต้องตรงกับที่บัญชีคุณเรียกได้จริง
# (ดูรายชื่อด้วย pnpm preflight — เดาชื่อรุ่นแล้วจะได้ 404 ที่ไม่บอกสาเหตุ)
LLM_PROVIDER=
OPENAI_TEXT_MODEL=

# เสียงบรรยายไทย — Google Cloud Text-to-Speech (เปิด API ในโปรเจคก่อน)
# ดูรายชื่อเสียงไทยที่ใช้ได้จริงด้วย listThaiVoices() อย่าเดาชื่อเสียงเอง
GOOGLE_TTS_API_KEY=
GOOGLE_TTS_VOICE=

# สลับไปใช้เสียงของ OpenAI แทน — ปล่อยว่าง = ใช้ Google (ค่าเริ่มต้น)
# ⚠️ เอกสาร OpenAI บอกแค่ "รองรับ 50+ ภาษา" ไม่ได้ระบุไทยไว้ชัด ยืนยันไม่ได้ว่าดีแค่ไหน
#    ฟังเทียบเองก่อนเปลี่ยน: pnpm voice-sample-openai (เทียบกับ pnpm voice-sample)
#    ฟังตรงวรรณยุกต์กับสระบน-ล่างเป็นพิเศษ — เป็นจุดที่โมเดลที่ไม่ได้เทรนไทยจะเพี้ยน
TTS_PROVIDER=
OPENAI_TTS_VOICE=
OPENAI_TTS_MODEL=

# ภาพประกอบ — Pexels (ฟรี 200 คำขอ/ชม. 20,000/เดือน)
# ⚠️ ทุกภาพที่ใช้ต้องบันทึกเครดิตช่างภาพลง video_assets เราแจ้ง Pexels ไว้แล้วว่าจะทำ
PEXELS_API_KEY=

# ภาพประกอบทางที่สอง — ให้ AI วาด (เปิดต่อช่องที่หน้าตั้งค่า ไม่ใช่สวิตช์ทั้งระบบ)
# ไม่มีเพดานแบบ Pexels และภาพตรงเนื้อหากว่า แต่เสียเงินต่อภาพ (~$0.07 คุณภาพกลาง)
# ⚠️ คลิปที่ใช้ภาพ AI ต้องเปิดเผย — ระบบใส่บรรทัดในคำอธิบายให้ และตอนอัปขึ้น
#    YouTube ต้องติ๊กช่อง altered/synthetic content ด้วย (นโยบาย Inauthentic Content)
# ⚠️ ห้ามใส่คีย์นี้ฝั่งเว็บ — worker เท่านั้น เหมือน ANTHROPIC_API_KEY
OPENAI_API_KEY=
# ค่าเริ่มต้น gpt-image-2 · gpt-image-1 ประกาศเลิกใช้ 23 ต.ค. 2569 อย่าถอยกลับไปใช้
OPENAI_IMAGE_MODEL=

# ── สร้างคลิปโฆษณาสั้นด้วย AI (แยกจากคลิปเล่าเรื่องที่ประกอบจากภาพนิ่ง) ──
# ไม่ตั้งคีย์เลย = ฟีเจอร์นี้ปิดสนิท ระบบเดิมทำงานปกติทุกอย่าง
# เอกสารเต็ม: docs/video-architecture.md
#
# Veo ผ่าน Gemini API — $0.05/วินาที lite · $0.10 fast · $0.40 quality (รวมเสียง)
# สร้างได้ครั้งละ ~8 วินาที · คลิป 50 วินาทีต้องสร้าง 7 ท่อนแล้วต่อกัน
GOOGLE_AI_API_KEY=
# ตั้งเฉพาะเมื่อ Google เปลี่ยนชื่อรุ่น (ดูรุ่นที่บัญชีมีด้วย pnpm preflight)
VEO_MODEL_LITE=
VEO_MODEL_FAST=
VEO_MODEL_QUALITY=

# Runway — เจ้าสำรอง เผื่อวันที่ Veo ขึ้นราคาหรือปิด
# ⚠️ ต้องตั้งราคาต่อวินาทีเอง ไม่งั้นระบบจะปฏิเสธไม่ให้ใช้ — Runway คิดเป็นเครดิต
#    ซึ่งราคาต่อเครดิตต่างกันตามแพ็ก เดาแทนไม่ได้ และด่านคุมงบต้องรู้ราคาถึงจะทำงาน
RUNWAY_API_KEY=
RUNWAY_USD_PER_SECOND=
RUNWAY_MODEL_LITE=
RUNWAY_MODEL_FAST=
RUNWAY_MODEL_QUALITY=
RUNWAY_MAX_SECONDS=
RUNWAY_API_VERSION=

# ── ด่านคุมงบ ──
# เครดิตของระบบกันได้แค่ "จำนวนงาน" ไม่ได้กัน "ขนาดของงานแต่ละชิ้น"
# บั๊กที่ส่งความยาวผิดหน่วยครั้งเดียว (8 → 800) ทำเงินหายสิบเท่าโดยเครดิตไม่รู้สึกอะไร
MAX_VIDEO_COST_USD=5
MAX_VIDEO_DURATION_SECONDS=30

# จำนวนครั้งที่แต่ละองค์กรสั่งได้ต่อชั่วโมง
# ⚠️ ตัวนับอยู่ในหน่วยความจำ ใช้ได้จริงเมื่อรัน instance เดียว — บน Vercel หลาย
#    instance ตัวนับแยกกัน เพดานจริง = ค่านี้ × จำนวน instance (ดู lib/video/rate-limit.ts)
VIDEO_RATE_LIMIT=10
VIDEO_REQUEST_TIMEOUT_MS=30000

# YouTube Data API — ใช้จำกัดโควตาต่อ Google Cloud project
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_QUOTA_DAILY_LIMIT=10000

# worker
WORKER_ID=worker-local
WORKER_POLL_INTERVAL_MS=2000

# ฟอนต์ซับไทย — ต้องเป็นชื่อฟอนต์ที่ "เครื่องที่รัน worker" มีจริง
# Windows: Leelawadee UI (หรือ Tahoma) · macOS: Thonburi · Linux: Loma (ค่าเริ่มต้น ปล่อยว่างได้)
# ตั้งผิด = ffmpeg ไม่ฟ้อง (exit 0) และ libass หาฟอนต์ไทยตัวอื่นในเครื่องมาวาดแทนเงียบ ๆ
# คลิปยังอ่านออก แต่หน้าตาซับไม่ใช่ที่เลือกไว้ จึงต้องตั้งเองให้ตรงเครื่องที่รัน worker
SUBTITLE_FONT=
# ใส่เฉพาะกรณีใช้ไฟล์ฟอนต์ที่ไม่ได้ติดตั้งในระบบ
SUBTITLE_FONTS_DIR=

# Amplitude — วัดการใช้งานระบบและผลของคลิป (ไม่ใส่ = ปิดสนิท ไม่ error)
# ⚠️ อย่าตั้งชื่อขึ้นต้น NEXT_PUBLIC_ เด็ดขาด คีย์จะหลุดไปฝั่ง browser
# อีเวนต์ทุกตัวติดป้าย product=yt-factory ไว้แล้ว แยกจากผลิตภัณฑ์อื่นใน project เดียวกันได้
AMPLITUDE_API_KEY=
