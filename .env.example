# คัดลอกเป็น .env.local แล้วเติมค่าจริง — ห้าม commit .env.local

# Supabase (ฝั่ง browser ใช้ได้ทั้งคู่ publishable key เป็น public โดยดีไซน์)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ⚠️ ข้าม RLS ทั้งหมด — ใช้ได้เฉพาะ worker/ กับ route handler ฝั่ง server
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (สร้างสคริปต์)
ANTHROPIC_API_KEY=

# เสียงบรรยายไทย — Google Cloud Text-to-Speech (เปิด API ในโปรเจคก่อน)
# ดูรายชื่อเสียงไทยที่ใช้ได้จริงด้วย listThaiVoices() อย่าเดาชื่อเสียงเอง
GOOGLE_TTS_API_KEY=
GOOGLE_TTS_VOICE=

# ภาพประกอบ — Pexels (ฟรี 200 คำขอ/ชม. 20,000/เดือน)
# ⚠️ ทุกภาพที่ใช้ต้องบันทึกเครดิตช่างภาพลง video_assets เราแจ้ง Pexels ไว้แล้วว่าจะทำ
PEXELS_API_KEY=

# YouTube Data API — ใช้จำกัดโควตาต่อ Google Cloud project
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_QUOTA_DAILY_LIMIT=10000

# worker
WORKER_ID=worker-local
WORKER_POLL_INTERVAL_MS=2000

# ฟอนต์ซับไทย — ต้องเป็นชื่อฟอนต์ที่ "เครื่องที่รัน worker" มีจริง
# Windows: Leelawadee UI (หรือ Tahoma) · macOS: Thonburi · Linux: Loma (ค่าเริ่มต้น ปล่อยว่างได้)
# ตั้งผิด = ffmpeg ไม่ฟ้อง (exit 0) และ libass หาฟอนต์ไทยตัวอื่นในเครื่องมาวาดแทนเงียบ ๆ
# คลิปยังอ่านออก แต่หน้าตาซับไม่ใช่ที่เลือกไว้ จึงต้องตั้งเองให้ตรงเครื่องที่รัน worker
SUBTITLE_FONT=
# ใส่เฉพาะกรณีใช้ไฟล์ฟอนต์ที่ไม่ได้ติดตั้งในระบบ
SUBTITLE_FONTS_DIR=

# Amplitude — วัดการใช้งานระบบและผลของคลิป (ไม่ใส่ = ปิดสนิท ไม่ error)
# ⚠️ อย่าตั้งชื่อขึ้นต้น NEXT_PUBLIC_ เด็ดขาด คีย์จะหลุดไปฝั่ง browser
# อีเวนต์ทุกตัวติดป้าย product=yt-factory ไว้แล้ว แยกจากผลิตภัณฑ์อื่นใน project เดียวกันได้
AMPLITUDE_API_KEY=
